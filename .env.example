# No secrets are required to run or deploy this static site.
# Copy to `.env` only if you add private config later.
#
# The original SJSU fork included Upstash Redis credentials here.
# This Mines site does not use Upstash. Do not commit real tokens.
#
# UPSTASH_REDIS_REST_URL="https://YOUR-ENDPOINT.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"
